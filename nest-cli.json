{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-core/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "templates/**/*",
        "watchAssets": true
      }
    ],
    "webpack": true,
    "tsConfigPath": "apps/api-core/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-core",
  "projects": {
    "game-service": {
      "type": "application",
      "root": "apps/game-service",
      "entryFile": "main",
      "sourceRoot": "apps/game-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/game-service/tsconfig.app.json"
      }
    },
    "api-core": {
      "type": "application",
      "root": "apps/api-core",
      "entryFile": "main",
      "sourceRoot": "apps/api-core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-core/tsconfig.app.json"
      }
    }
  }
}