<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email confirmado</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet">

  <style>
    :root {
      --bg: #f7f8fa;
      --card: #ffffff;
      --ink: #1f2430;
      --muted: #6b7280;
      --accent: #2f9e6f;
      --accent-soft: #e9f6f0;
      --ring: rgba(47, 158, 111, 0.18);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      height: 100%;
    }

    body {
      min-height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background:
        radial-gradient(1200px 600px at 50% -10%, #eef2f7 0%, var(--bg) 55%);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: var(--ink);
    }

    .card {
      width: 100%;
      max-width: 420px;
      background: var(--card);
      border: 1px solid #eef0f3;
      border-radius: 20px;
      padding: 40px 32px;
      text-align: center;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04),
        0 12px 32px rgba(16, 24, 40, 0.06);
      animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .badge {
      width: 72px;
      height: 72px;
      margin: 0 auto 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-soft);
      box-shadow: 0 0 0 8px var(--ring);
      animation: pop 0.5s 0.12s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .badge svg {
      width: 34px;
      height: 34px;
      stroke: var(--accent);
    }

    .badge svg path {
      stroke-dasharray: 28;
      stroke-dashoffset: 28;
      animation: draw 0.5s 0.3s ease forwards;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    p {
      margin: 0;
      font-size: 15px;
      line-height: 1.6;
      color: var(--muted);
    }

    .email {
      display: inline-block;
      margin-top: 18px;
      padding: 8px 14px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      font-weight: 500;
      font-size: 14px;
      word-break: break-all;
    }

    .hint {
      margin-top: 24px;
      font-size: 13px;
      color: #9aa1ad;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pop {
      from {
        opacity: 0;
        transform: scale(0.8);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  </style>
</head>

<body>
  <main class="card">
    <div class="badge">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12.5l4.5 4.5L19 7.5" />
      </svg>
    </div>

    <p>Endereço de email atualizado com sucesso.</p>

    <% if (typeof email !== 'undefined' && email) { %>
    <span class="email"><%= email %></span>
    <% } %>

    <p class="hint">Você já pode fechar esta janela.</p>
  </main>
</body>

</html>
