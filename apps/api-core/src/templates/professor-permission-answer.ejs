<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #f7f8fa;
      font-family: 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;
      color: #1f2430;
    }

    .wrapper {
      max-width: 520px;
      margin: 48px auto;
      padding: 0 16px;
    }

    .card {
      background: #ffffff;
      border: 1px solid #eef0f3;
      border-radius: 16px;
      padding: 40px 36px;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04),
        0 8px 24px rgba(16, 24, 40, 0.06);
    }

    .icon-wrap {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }

    .icon-wrap svg {
      width: 28px;
      height: 28px;
    }

    .is-approved .icon-wrap {
      background: #e9f6f0;
    }

    .is-approved .icon-wrap svg {
      stroke: #2f9e6f;
    }

    .is-rejected .icon-wrap {
      background: #fdecec;
    }

    .is-rejected .icon-wrap svg {
      stroke: #c2414a;
    }

    .status {
      display: inline-block;
      margin: 0 0 16px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .is-approved .status {
      background: #e9f6f0;
      color: #1f7a52;
    }

    .is-rejected .status {
      background: #fdecec;
      color: #a3202c;
    }

    h1 {
      margin: 0 0 8px;
      font-size: 20px;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: #1f2430;
    }

    p {
      margin: 0;
      font-size: 15px;
      line-height: 1.65;
      font-weight: 300;
      color: #6b7280;
    }

    p strong {
      font-weight: 500;
      color: #1f2430;
    }

    .footer {
      margin-top: 24px;
      text-align: center;
      font-size: 12px;
      color: #b0b8c4;
      line-height: 1.6;
    }
  </style>
</head>

<body>
  <% const approved = requestStatus === 'APPROVED'; %>
  <div class="wrapper">
    <div class="card <%= approved ? 'is-approved' : 'is-rejected' %>">
      <div class="icon-wrap">
        <% if (approved) { %>
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12.5l4.5 4.5L19 7.5"></path>
        </svg>
        <% } else { %>
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 7l10 10"></path>
          <path d="M17 7L7 17"></path>
        </svg>
        <% } %>
      </div>

      <p class="status"><%= approved ? 'Aprovada' : 'Recusada' %></p>
      <h1><%= approved ? 'Solicitação aprovada' : 'Solicitação recusada' %></h1>
      <p>
        Olá, <strong><%= name %></strong>.<br>
        <% if (approved) { %>
        Sua solicitação para atuar como professor foi aprovada.
        Faça login novamente para acessar as novas permissões.
        <% } else { %>
        Sua solicitação para atuar como professor foi recusada.
        Se quiser entender o motivo, fale com a sua instituição.
        <% } %>
      </p>
    </div>

    <p class="footer">
      Se você não reconhece esta solicitação, ignore este email.
    </p>
  </div>
</body>

</html>
