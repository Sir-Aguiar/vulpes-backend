generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  institutionId Int    @id @default(autoincrement())
  name          String @db.VarChar(255)

  users                       User[]
  professorPermissionRequests ProfessorPermissionRequest[]
}

model User {
  userId        String       @id @default(uuid())
  name          String       @db.VarChar(255)
  email         String       @unique @db.VarChar(255)
  password      String       @db.VarChar(255)
  institutionId Int?
  role          Role         @default(STUDENT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  submissions   Submission[]
  tasks         Task[]

  classes Class[]

  classStudents ClassStudent[]

  studentClassPermissionRequests StudentClassPermissionRequest[]
  institution                    Institution?                    @relation(fields: [institutionId], references: [institutionId])
}

enum TaskInputMode {
  PARAM
  LEIA
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

model Task {
  taskId      String        @id @default(uuid())
  creatorId   String
  title       String        @db.VarChar(255)
  description String        @db.Text
  functionDef String        @db.Text
  inputMode   TaskInputMode @default(PARAM)
  isVisible   Boolean       @default(true)
  isPublic    Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  taskParams  TaskParam[]
  taskTests   TaskTest[]
  submissions Submission[]
  creator     User         @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  classTasks ClassTask[]
}

model TaskParam {
  paramId String  @id @default(uuid())
  taskId  String
  name    String  @db.VarChar(255)
  type    String  @db.VarChar(100)
  isArray Boolean @default(false)

  task Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
}

model TaskTest {
  testId             String   @id @default(uuid())
  taskId             String
  input              String[] @db.Text
  expectedOutput     String   @db.Text
  expectedOutputType String   @db.VarChar(100)

  task Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
}

enum ProfessorPermissionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfessorPermissionRequest {
  professorPermissionRequestId Int                              @id @default(autoincrement())
  name                         String                           @db.VarChar(255)
  personalEmail                String                           @unique @db.VarChar(255)
  institutionalEmail           String                           @db.VarChar(255)
  institutionId                Int
  requestFileUrl               String                           @db.Text
  requestStatus                ProfessorPermissionRequestStatus @default(PENDING)

  institution Institution @relation(fields: [institutionId], references: [institutionId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professor_permission_requests")
}

model Submission {
  submissionId      String   @id @default(uuid())
  studentId         String
  taskId            String
  listId            String?
  code              String   @db.Text
  isCorrect         Boolean  @default(false)
  submittedAt       DateTime @default(now())
  professorComments String?  @db.Text

  task    Task  @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  list    List? @relation(fields: [listId], references: [listId], onDelete: SetNull)
}

model Class {
  classId     String   @id @default(uuid())
  code        Int      @unique
  name        String   @db.VarChar(255)
  professorId String
  professor   User     @relation(fields: [professorId], references: [userId], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classStudents ClassStudent[]

  studentClassPermissionRequests StudentClassPermissionRequest[]

  classTasks ClassTask[]

  lists List[]
}

model ClassStudent {
  classId   String
  studentId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [classId], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([classId, studentId])
}

model StudentClassPermissionRequest {
  classId   String
  studentId String
  message   String?  @db.Text
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [classId], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([classId, studentId])
  @@map("student_class_permission_requests")
}

model ClassTask {
  classId        String
  taskId         String
  createdAt      DateTime        @default(now())
  class          Class           @relation(fields: [classId], references: [classId], onDelete: Cascade)
  task           Task            @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  classTaskLists ClassTaskList[]

  @@id([classId, taskId])
}

model List {
  listId          String   @id @default(uuid())
  classId         String
  title           String   @db.VarChar(255)
  deadline        DateTime
  submissionLimit Int?     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  class           Class    @relation(fields: [classId], references: [classId], onDelete: Cascade)

  classTaskLists ClassTaskList[]
  submissions    Submission[]
}

model ClassTaskList {
  classId   String
  taskId    String
  listId    String
  createdAt DateTime  @default(now())
  classTask ClassTask @relation(fields: [classId, taskId], references: [classId, taskId], onDelete: Cascade)
  list      List      @relation(fields: [listId], references: [listId], onDelete: Cascade)

  @@id([classId, taskId, listId])
}
